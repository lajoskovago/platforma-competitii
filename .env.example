# Copy to .env.local and fill in. For local dev, values come from `supabase start`.
# For production, set the same variables in Render (and in .env.production.local
# only if you run `npm run create-admin:prod` from your machine).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (admin operations: inviting users). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Optional: public address of the site (used for redirects behind a proxy).
SITE_URL=
# Web push notifications (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret for the daily reminder job (GitHub Actions calls /api/cron/reminders)
CRON_SECRET=
