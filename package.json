{
  "name": "competitii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "db:types": "supabase gen types typescript > src/lib/database.types.ts",
    "db:reset": "supabase db reset",
    "test:db": "for f in supabase/tests/*.sql; do docker exec -i supabase_db_competitii psql -U postgres -v ON_ERROR_STOP=1 -q -At < $f || exit 1; done",
    "typecheck": "tsc --noEmit",
    "seed:dev-users": "tsx --env-file=.env.local scripts/seed-dev-users.ts",
    "create-admin:prod": "tsx --env-file=.env.production.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "lucide-react": "^0.460.0",
    "next": "16.4.5",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
